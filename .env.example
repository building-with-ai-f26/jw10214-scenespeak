# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Set to 1 when deployed behind a proxy (e.g. Render) so the rate limit sees the real visitor IP.
# Leave unset locally.
TRUST_PROXY=
